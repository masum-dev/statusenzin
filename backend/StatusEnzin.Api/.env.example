# =============================================================================
# Backend Environment Configuration (for local dev WITHOUT Docker)
# When using docker compose, env vars come from the root .env file instead.
# Copy to .env and fill in real values before running: dotnet run
# =============================================================================

# PostgreSQL Database Connection String (REQUIRED)
# Local PostgreSQL:  Host=localhost;Port=5432;Database=statusenzin;Username=postgres;Password=YOUR_PASSWORD
# Neon cloud:        postgresql://user:pass@ep-xxx.region.aws.neon.tech/statusenzin?sslmode=require
DATABASE_URL=Host=localhost;Port=5432;Database=statusenzin;Username=postgres;Password=your_postgres_password

# Server & Client URLs
API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Platform Super Admin Configuration
SUPER_ADMIN_EMAIL=admin@statusenzin.me
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_FULL_NAME=Admin
SUPER_ADMIN_TENANT_NAME=Default

# JWT Authentication Configuration
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ISSUER=StatusEnzin
JWT_AUDIENCE=StatusEnzinApp

# Stripe Configuration (leave empty for mock mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
STRIPE_COUPON_SAVE20=
STRIPE_COUPON_WELCOME20=
STRIPE_COUPON_PROMO10=
STRIPE_COUPON_HALFPRICE=

# Resend / Email Configuration (leave empty to log to console)
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@statusenzin.me

# Monitoring Engine Configuration
MONITOR_CHECK_INTERVAL_SECONDS=15
MONITOR_HTTP_TIMEOUT_SECONDS=15

# Seed demo content (Acme status page, monitors, incidents)
# Defaults: true in Development, false in Production
SEED_DEMO_DATA=true
