# =============================================================================
# Frontend Environment Configuration
# Copy to .env.local for local dev, or set via docker-compose build args.
# =============================================================================

# Backend URL the browser calls (REQUIRED)
# Docker:  http://localhost:8080
# Local dev (no Docker): http://localhost:5001
NEXT_PUBLIC_API_URL=http://localhost:8080

# Frontend base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe publishable key (leave empty for mock mode — card field won't work without it)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public status page poll interval (ms)
NEXT_PUBLIC_STATUS_PAGE_POLL_INTERVAL_MS=20000

# Branding & demo
NEXT_PUBLIC_APP_NAME=StatusEnzin
NEXT_PUBLIC_DEMO_SLUG=acme
